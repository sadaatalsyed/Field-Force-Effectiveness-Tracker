// Shop Time %
Shop Time % =
VAR TotalShopTime = SUM('Sheet3-MarketTime&GPS'[TotalTimeSpentInShops_HHMM])
				VAR TotalFieldTime = SUM('Sheet3-MarketTime&GPS'[TotalTimeSpentInField_HHMM])
				RETURN
				IF(
				    TotalFieldTime = 0,
				    "",
				    ROUND(DIVIDE(TotalShopTime, TotalFieldTime,0), 3)
				)

// Shops With GPS
Shops With GPS =
VAR TotalCount = SUM('Sheet3-MarketTime&GPS'[ShopsVisitedWithGPS])
				RETURN
				IF(TotalCount = 0, "", TotalCount)

// Shops Without GPS
Shops Without GPS =
SUM('Sheet3-MarketTime&GPS'[ShopsVisitedWithoutGPS])

// Total Idle Period (HH:MM)
Total Idle Period (HH:MM) =
VAR TotalSeconds = MEDIAN('Sheet3-MarketTime&GPS'[TotalIdlePeriod_HHMM])
				RETURN
				IF(
				    ISBLANK(TotalSeconds) || TotalSeconds = 0,
				    "",
				    FORMAT(INT(TotalSeconds / 3600), "00") & ":" & FORMAT(MOD(INT(TotalSeconds / 60), 60), "00")
				)

