Total Idle Period (Seconds) Derived =
VAR MedianIdleSeconds =
				    MEDIAN('Sheet3-MarketTime&GPS'[TotalIdlePeriod_HHMM])
				
				RETURN
				IF(
				    ISBLANK(MedianIdleSeconds) || MedianIdleSeconds = 0,
				    BLANK(),
				    INT(MedianIdleSeconds)
				)

// Total Idle Period (Seconds) Median
Total Idle Period (Seconds) Median =
VAR MedianIdleSeconds =
				    MEDIAN('Sheet3-MarketTime&GPS'[TotalIdlePeriod_HHMM])
				
				RETURN
