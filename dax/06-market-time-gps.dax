// No GPS %
No GPS % =
DIVIDE(SUM('Sheet3-MarketTime&GPS'[ShopsVisitedWithoutGPS]),SUM('Sheet3-MarketTime&GPS'[TotalStopRows]),0)

// OBs Worked s3
OBs Worked s3 =
DISTINCTCOUNT('Sheet3-MarketTime&GPS'[OBCode])

