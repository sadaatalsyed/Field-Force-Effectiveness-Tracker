// Field Time (HH:MM)
Field Time (HH:MM) =
VAR ValidRows =
				    FILTER(
				        'Sheet3-MarketTime&GPS',
				        NOT ISBLANK('Sheet3-MarketTime&GPS'[TotalTimeSpentInField_HHMM])
				    )
				VAR MedianSeconds =
				    IF(
				        COUNTROWS(ValidRows) = 0,
				        BLANK(),
				        MEDIANX(ValidRows, 'Sheet3-MarketTime&GPS'[TotalTimeSpentInField_HHMM])
				    )
				RETURN
				IF(
				    ISBLANK(MedianSeconds),
				    "",
				    FORMAT(INT(MedianSeconds / 3600), "00") & ":" & FORMAT(MOD(INT(MedianSeconds / 60), 60), "00")
				)

// Field Time (HH:MM) Derived
Field Time (HH:MM) Derived =
VAR MedStart = [Day Start (Median Time)]   -- fraction value, not the "-" text version
				VAR MedEnd   = [Day End (Median Time)]
				RETURN
				IF(
				    OR(ISBLANK(MedStart), ISBLANK(MedEnd)),
				    "",
				    VAR DiffSeconds = (MedEnd - MedStart) * 86400
				    RETURN FORMAT(INT(DiffSeconds / 3600), "00") & ":" & FORMAT(MOD(INT(DiffSeconds / 60), 60), "00")
				)

// Field Time Median
Field Time Median =
VAR MedStart = [Day Start (Median Time)]   -- fraction value, not the "-" text version
				VAR MedEnd   = [Day End (Median Time)]
				RETURN
				IF(
				    OR(ISBLANK(MedStart), ISBLANK(MedEnd)),
				    "",
				     (MedEnd - MedStart) * 86400
				)

