# ORIGINAL DAX EXPRESSIONS — Extracted from user-supplied TMDL
# Table: Sheet3-MarketTime&GPS
# Exact source expressions kept, not refactored. Some may have known logic concerns.

// % Shops Without GPS
% Shops Without GPS =
VAR NoGPS = SUM('Sheet3-MarketTime&GPS'[ShopsVisitedWithoutGPS])
				VAR TotalStops = SUM('Sheet3-MarketTime&GPS'[TotalStopRows])
				RETURN
				IF(
				    TotalStops = 0,
				    "-",
				    ROUND(DIVIDE(NoGPS, TotalStops) * 100, 2) & "%"
				)

// Active Market Time (HH:MM)
Active Market Time (HH:MM) =
VAR ValidRows =
				    FILTER(
				        'Sheet3-MarketTime&GPS',
				        NOT ISBLANK('Sheet3-MarketTime&GPS'[ActiveMarketTime_HHMM])
				    )
				VAR MedianSeconds =
				    IF(
				        COUNTROWS(ValidRows) = 0,
				        BLANK(),
				        MEDIANX(ValidRows, 'Sheet3-MarketTime&GPS'[ActiveMarketTime_HHMM])
				    )
				RETURN
				IF(
				    ISBLANK(MedianSeconds),
				    "",
				    FORMAT(INT(MedianSeconds / 3600), "00") & ":" & FORMAT(MOD(INT(MedianSeconds / 60), 60), "00")
				)

// Active Market Time Median
Active Market Time Median =
VAR ValidRows =
				    FILTER(
				        'Sheet3-MarketTime&GPS',
				        NOT ISBLANK('Sheet3-MarketTime&GPS'[ActiveMarketTime_HHMM])
				    )
				VAR MedianSeconds =
				    IF(
				        COUNTROWS(ValidRows) = 0,
				        BLANK(),
				        MEDIANX(ValidRows, 'Sheet3-MarketTime&GPS'[ActiveMarketTime_HHMM])
				    )
				RETURN
				IF(
				    ISBLANK(MedianSeconds),
				    "",
				    MedianSeconds
				)

// Avg Stops per Day
Avg Stops per Day =
AVERAGEX(
				    VALUES('Date Table'[Date]),
				    CALCULATE(SUM('Sheet3-MarketTime&GPS'[TotalStopsMade]))
				)

// Avg Time Between Visits (Minutes)
Avg Time Between Visits (Minutes) =
VAR ValidRows =
				    FILTER(
				        'Sheet3-MarketTime&GPS',
				        NOT ISBLANK('Sheet3-MarketTime&GPS'[AvgTimeBetweenVisitsMinutes])
				    )
				VAR MedianValue =
				    IF(
				        COUNTROWS(ValidRows) = 0,
				        BLANK(),
				        MEDIANX(ValidRows, 'Sheet3-MarketTime&GPS'[AvgTimeBetweenVisitsMinutes])
				    )
				RETURN
				IF(ISBLANK(MedianValue), "", ROUND(MedianValue, 2) & " min")

// Avg Time Between Visits (Seconds)
Avg Time Between Visits (Seconds) =
VAR ValidRows =
				    FILTER(
				        'Sheet3-MarketTime&GPS',
				        NOT ISBLANK('Sheet3-MarketTime&GPS'[AvgTimeBetweenVisitsMinutes])
				    )
				
				VAR MedianValue =
				    IF(
				        COUNTROWS(ValidRows) = 0,
				        BLANK(),
				        MEDIANX(
				            ValidRows,
				            'Sheet3-MarketTime&GPS'[AvgTimeBetweenVisitsMinutes]
				        )
				    )
				
				RETURN
				IF(
				    ISBLANK(MedianValue),
				    BLANK(),
				    INT(MedianValue * 60)
				)

// Before/After Field Time (HH:MM)
Before/After Field Time (HH:MM) =
VAR ValidRows =
				    FILTER(
				        'Sheet3-MarketTime&GPS',
				        NOT ISBLANK('Sheet3-MarketTime&GPS'[TotalTimeSpentInField_HHMM])
				            && NOT ISBLANK('Sheet3-MarketTime&GPS'[TotalTimeSpentInTrade_HHMM])
				    )
				
				VAR MedianDifference =
				    MEDIANX(
				        ValidRows,
				        'Sheet3-MarketTime&GPS'[TotalTimeSpentInField_HHMM]
				            - 'Sheet3-MarketTime&GPS'[TotalTimeSpentInTrade_HHMM]
				    )
				
				RETURN
				IF(
				    ISBLANK(MedianDifference),
				    "",
				    FORMAT(INT(MedianDifference / 3600), "00")
				        & ":"
				        & FORMAT(MOD(INT(MedianDifference / 60), 60), "00")
				)

// Before/After Field Time (seconds)
Before/After Field Time (seconds) =
VAR ValidRows =
				    FILTER(
				        'Sheet3-MarketTime&GPS',
				        NOT ISBLANK('Sheet3-MarketTime&GPS'[TotalTimeSpentInField_HHMM])
				            && NOT ISBLANK('Sheet3-MarketTime&GPS'[TotalTimeSpentInTrade_HHMM])
				    )
				
				VAR MedianDifference =
				    MEDIANX(
				        ValidRows,
				        'Sheet3-MarketTime&GPS'[TotalTimeSpentInField_HHMM]
				            - 'Sheet3-MarketTime&GPS'[TotalTimeSpentInTrade_HHMM]
				    )
				
				RETURN
				IF(
				    ISBLANK(MedianDifference),
				    BLANK(),
				    INT(MedianDifference)
				)

// Data Quality
Data Quality =
VAR _fieldTime = [Field Time (HH:MM)]
				VAR _gps = [GPS Compliance %]
				RETURN
				SWITCH(
				    TRUE(),
				    ISBLANK(_fieldTime) || _fieldTime=""  , "absent",
				    _gps >= 0.85, "Reliable",
				    _gps >= 0.75, "Gaps",
				    "Unreliable"
				)

// Day End (Median Time)
Day End (Median Time) =
VAR ValidRows =
				    FILTER(
				        'Sheet3-MarketTime&GPS',
				        NOT ISBLANK('Sheet3-MarketTime&GPS'[DayEnd])
				    )
				Return
				    IF(
				        COUNTROWS(ValidRows) = 0,
				        BLANK(),
				        MEDIANX(ValidRows, MOD('Sheet3-MarketTime&GPS'[DayEnd], 1))
				    )

// Day End (Median Time) Display
Day End (Median Time) Display =
VAR ValidRows =
				    FILTER(
				        'Sheet3-MarketTime&GPS',
				        NOT ISBLANK('Sheet3-MarketTime&GPS'[DayEnd])
				    )
				VAR MedianFraction =
				    IF(
				        COUNTROWS(ValidRows) = 0,
				        BLANK(),
				        MEDIANX(ValidRows, MOD('Sheet3-MarketTime&GPS'[DayEnd], 1))
				    )
				RETURN
				IF(ISBLANK(MedianFraction), "", FORMAT(MedianFraction, "hh:mm AM/PM"))

