// Trade Time (HH:MM)
Trade Time (HH:MM) =
VAR ValidRows =
				    FILTER(
				        'Sheet3-MarketTime&GPS',
				        NOT ISBLANK('Sheet3-MarketTime&GPS'[TotalTimeSpentInTrade_HHMM])
				    )
				VAR MedianSeconds =
				    IF(
				        COUNTROWS(ValidRows) = 0,
				        BLANK(),
				        MEDIANX(ValidRows, 'Sheet3-MarketTime&GPS'[TotalTimeSpentInTrade_HHMM])
				    )
				RETURN
				IF(
				    ISBLANK(MedianSeconds),
				    "",
				    FORMAT(INT(MedianSeconds / 3600), "00") & ":" & FORMAT(MOD(INT(MedianSeconds / 60), 60), "00")
				)

// Trade Time (HH:MM) Derived
Trade Time (HH:MM) Derived =
VAR MedStart = [First Shop Called At (Median Time)]   -- fraction value, not the "-" text version
				VAR MedEnd   = [Last Shop Completed At (Median Time)]
				RETURN
				IF(
				    OR(ISBLANK(MedStart), ISBLANK(MedEnd)),
				    "",
				    VAR DiffSeconds = (MedEnd - MedStart) * 86400
				    RETURN FORMAT(INT(DiffSeconds / 3600), "00") & ":" & FORMAT(MOD(INT(DiffSeconds / 60), 60), "00")
				)

// Trade Time Median
Trade Time Median =
VAR MedStart = [First Shop Called At (Median Time)]   -- fraction value, not the "-" text version
				VAR MedEnd   = [Last Shop Completed At (Median Time)]
				RETURN
				IF(
				    OR(ISBLANK(MedStart), ISBLANK(MedEnd)),
				    "",
				     (MedEnd - MedStart) * 86400
				)
