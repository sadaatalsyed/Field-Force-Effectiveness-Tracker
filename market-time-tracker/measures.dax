/* ============================================================================================
   SHEET 3 - MARKET TIME & GPS — DAX Measures
   ICE Daily Tracker

   Aggregation strategy summary:
   - Additive counts (Stops, GPS counts, Distance, Total Idle)  -> SUM
   - Clock-time points (Day Start/End, First/Last Called At)    -> MEDIANX on MOD(x,1)
   - Durations (Field/Trade/Shop/Active Market Time)             -> MEDIANX on raw seconds,
                                                                     independently per KPI
                                                                     (never derived by subtracting
                                                                     two already-aggregated medians)
   - Worst-case flag (Longest Idle Period)                       -> MAXX
   - Ratios/percentages (GPS Compliance %, Shop Time %, etc.)    -> SUM(num) / SUM(denom),
                                                                     never average a pre-computed %
   ============================================================================================ */


/* ---------------------------------------------------------------------
   1. CLOCK-TIME KPIs
   MOD(x, 1) strips the date component, keeping only time-of-day,
   so multi-day selections don't corrupt the median.
--------------------------------------------------------------------- */

Day Start (Median Time) =
VAR ValidRows =
    FILTER(
        'Sheet3-MarketTime&GPS',
        NOT ISBLANK('Sheet3-MarketTime&GPS'[DayStart])
    )
VAR MedianFraction =
    IF(
        COUNTROWS(ValidRows) = 0,
        BLANK(),
        MEDIANX(ValidRows, MOD('Sheet3-MarketTime&GPS'[DayStart], 1))
    )
RETURN
IF(ISBLANK(MedianFraction), "-", FORMAT(MedianFraction, "hh:mm AM/PM"))


Day End (Median Time) =
VAR ValidRows =
    FILTER(
        'Sheet3-MarketTime&GPS',
        NOT ISBLANK('Sheet3-MarketTime&GPS'[DayEnd])
    )
VAR MedianFraction =
    IF(
        COUNTROWS(ValidRows) = 0,
        BLANK(),
        MEDIANX(ValidRows, MOD('Sheet3-MarketTime&GPS'[DayEnd], 1))
    )
RETURN
IF(ISBLANK(MedianFraction), "-", FORMAT(MedianFraction, "hh:mm AM/PM"))


