IF(ISBLANK(MedianFraction), "-", FORMAT(MedianFraction, "hh:mm AM/PM"))


/* ---------------------------------------------------------------------
   2. DURATION KPIs (HH:MM / HH:MM:SS)
   Each operates independently on its own pre-computed raw-seconds column.
--------------------------------------------------------------------- */

Field Time (HH:MM) =
VAR ValidRows =
    FILTER(
        'Sheet3-MarketTime&GPS',
        NOT ISBLANK('Sheet3-MarketTime&GPS'[FieldTimeSeconds])
    )
VAR MedianSeconds =
    IF(
        COUNTROWS(ValidRows) = 0,
        BLANK(),
        MEDIANX(ValidRows, 'Sheet3-MarketTime&GPS'[FieldTimeSeconds])
    )
RETURN
IF(
    ISBLANK(MedianSeconds),
    "-",
    FORMAT(INT(MedianSeconds / 3600), "00") & ":" & FORMAT(MOD(INT(MedianSeconds / 60), 60), "00")
)


Trade Time (HH:MM) =
VAR ValidRows =
    FILTER(
        'Sheet3-MarketTime&GPS',
        NOT ISBLANK('Sheet3-MarketTime&GPS'[TradeTimeSeconds])
    )
VAR MedianSeconds =
    IF(
        COUNTROWS(ValidRows) = 0,
        BLANK(),
        MEDIANX(ValidRows, 'Sheet3-MarketTime&GPS'[TradeTimeSeconds])
    )
RETURN
IF(
    ISBLANK(MedianSeconds),
    "-",
    FORMAT(INT(MedianSeconds / 3600), "00") & ":" & FORMAT(MOD(INT(MedianSeconds / 60), 60), "00")
)


Active Market Time (HH:MM) =
VAR ValidRows =
    FILTER(
        'Sheet3-MarketTime&GPS',
        NOT ISBLANK('Sheet3-MarketTime&GPS'[ActiveMarketTimeSeconds])
    )
VAR MedianSeconds =
    IF(
        COUNTROWS(ValidRows) = 0,
        BLANK(),
        MEDIANX(ValidRows, 'Sheet3-MarketTime&GPS'[ActiveMarketTimeSeconds])
    )
RETURN
IF(
    ISBLANK(MedianSeconds),
    "-",
    FORMAT(INT(MedianSeconds / 3600), "00") & ":" & FORMAT(MOD(INT(MedianSeconds / 60), 60), "00")
)


Shop Time (HH:MM) =
VAR ValidRows =
    FILTER(
        'Sheet3-MarketTime&GPS',
        NOT ISBLANK('Sheet3-MarketTime&GPS'[ShopTimeSeconds])
    )
VAR MedianSeconds =
    IF(
        COUNTROWS(ValidRows) = 0,
        BLANK(),
        MEDIANX(ValidRows, 'Sheet3-MarketTime&GPS'[ShopTimeSeconds])
    )
RETURN
IF(
    ISBLANK(MedianSeconds),
    "-",
    FORMAT(INT(MedianSeconds / 3600), "00") & ":" & FORMAT(MOD(INT(MedianSeconds / 60), 60), "00")
)


Median Shop Time (HH:MM:SS) =
VAR ValidRows =
    FILTER(
        'Sheet3-MarketTime&GPS',
        NOT ISBLANK('Sheet3-MarketTime&GPS'[MedianShopTimeSeconds])
    )
VAR MedianSeconds =
    IF(
        COUNTROWS(ValidRows) = 0,
        BLANK(),
        MEDIANX(ValidRows, 'Sheet3-MarketTime&GPS'[MedianShopTimeSeconds])
    )
RETURN
IF(
    ISBLANK(MedianSeconds),
    "-",
    FORMAT(INT(MedianSeconds / 3600), "00") & ":" &
    FORMAT(MOD(INT(MedianSeconds / 60), 60), "00") & ":" &
    FORMAT(MOD(INT(MedianSeconds), 60), "00")
)
/* Note: this is a "median of medians" approximation.
   A statistically exact median requires a visit-level grain table. */


/* ---------------------------------------------------------------------
   3. IDLE TIME KPIs
--------------------------------------------------------------------- */

Total Idle Period (HH:MM) =
VAR TotalSeconds = SUM('Sheet3-MarketTime&GPS'[IdleSeconds])
RETURN
IF(
    ISBLANK(TotalSeconds) || TotalSeconds = 0,
    "-",
    FORMAT(INT(TotalSeconds / 3600), "00") & ":" & FORMAT(MOD(INT(TotalSeconds / 60), 60), "00")
)


Longest Idle Period (HH:MM:SS) =
VAR ValidRows =
    FILTER(
        'Sheet3-MarketTime&GPS',
        NOT ISBLANK('Sheet3-MarketTime&GPS'[LongestIdleSeconds])
    )
VAR MaxSeconds =
    IF(
        COUNTROWS(ValidRows) = 0,
        BLANK(),
        MAXX(ValidRows, 'Sheet3-MarketTime&GPS'[LongestIdleSeconds])
    )
RETURN
IF(
    ISBLANK(MaxSeconds),
    "-",
    FORMAT(INT(MaxSeconds / 3600), "00") & ":" &
    FORMAT(MOD(INT(MaxSeconds / 60), 60), "00") & ":" &
    FORMAT(MOD(INT(MaxSeconds), 60), "00")
)


/* ---------------------------------------------------------------------
   4. GPS KPIs
--------------------------------------------------------------------- */

Shops With GPS =
VAR TotalCount = SUM('Sheet3-MarketTime&GPS'[ShopsWithGPS])
RETURN
IF(TotalCount = 0, "-", TotalCount)


Shops Without GPS =
VAR TotalCount = SUM('Sheet3-MarketTime&GPS'[ShopsWithoutGPS])
RETURN
IF(TotalCount = 0, "-", TotalCount)


% Shops Without GPS =
VAR NoGPS = SUM('Sheet3-MarketTime&GPS'[ShopsWithoutGPS])
VAR TotalStops = SUM('Sheet3-MarketTime&GPS'[TotalStopRows])
RETURN
IF(
    TotalStops = 0,
    "-",
    ROUND(DIVIDE(NoGPS, TotalStops) * 100, 2) & "%"
)


GPS Compliance % =
VAR TotalValidGPS = SUM('Sheet3-MarketTime&GPS'[ValidGPSCount])
VAR TotalGPSShops = SUM('Sheet3-MarketTime&GPS'[ShopsWithGPS])
RETURN
IF(
    TotalGPSShops = 0,
    "-",
    ROUND(DIVIDE(TotalValidGPS, TotalGPSShops) * 100, 2) & "%"
)
/* Denominator is ShopsWithGPS (not Total Stops), per business definition:
   "Visits within 100m / GPS Shops" — measures accuracy only among visits
   that had GPS data available to check in the first place. */


/* ---------------------------------------------------------------------
   5. RATIO KPIs
--------------------------------------------------------------------- */

Shop Time % =
VAR TotalShopTime = SUM('Sheet3-MarketTime&GPS'[ShopTimeSeconds])
VAR TotalFieldTime = SUM('Sheet3-MarketTime&GPS'[FieldTimeSeconds])
RETURN
IF(
    TotalFieldTime = 0,
    "-",
    ROUND(DIVIDE(TotalShopTime, TotalFieldTime) * 100, 2) & "%"
)


Avg Time Between Visits (Minutes) =
VAR ValidRows =
    FILTER(
        'Sheet3-MarketTime&GPS',
        NOT ISBLANK('Sheet3-MarketTime&GPS'[AvgTimeBetweenVisitsMinutes])
    )
VAR MedianValue =
    IF(
        COUNTROWS(ValidRows) = 0,
        BLANK(),
        MEDIANX(ValidRows, 'Sheet3-MarketTime&GPS'[AvgTimeBetweenVisitsMinutes])
    )
RETURN
IF(ISBLANK(MedianValue), "-", ROUND(MedianValue, 1) & " min")
